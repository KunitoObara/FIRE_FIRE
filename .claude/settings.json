{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(firebase deploy:*)",
      "Bash(rm -rf:*)",
      "Read(./docs/.env)",
      "Read(./docs/.env.*)"
    ],
    "ask": [
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ],
    "allow": [
      "mcp__trello__get_lists",
      "mcp__trello__get_board_labels",
      "mcp__trello__get_board_members",
      "mcp__trello__get_cards_by_list_id",
      "mcp__trello__get_card",
      "mcp__trello__get_card_comments",
      "mcp__trello__get_card_history",
      "mcp__trello__get_checklist_items",
      "mcp__trello__get_acceptance_criteria",
      "mcp__trello__move_card",
      "mcp__trello__add_comment",
      "mcp__trello__add_card_to_list",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "force push をチェック中",
            "command": "c=$(jq -r '.tool_input.command'); case \"$c\" in *'git push'*) ;; *) exit 0 ;; esac; printf '%s' \"$c\" | grep -Eq '(^|[[:space:]])(-f|--force|--force-with-lease)([[:space:]=]|$)|[[:space:]]\\+[^[:space:]]+' && printf '%s' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"force push は禁止です(docs/development-workflow.md 8章)。--force / -f / --force-with-lease と + 付きリフスペックのいずれも対象です。\"}}'; exit 0"
          }
        ]
      }
    ]
  }
}
