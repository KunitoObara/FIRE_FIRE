# Firebase クライアントSDKの設定値。
# このファイルをコピーして `.env.local` を作り、Firebaseコンソール
# (プロジェクトの設定 → マイアプリ → ウェブアプリ)の値を記入する。
# `.env.local` はコミットしない(.gitignore で除外済み)。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Authエミュレータの接続先。設定されている間、認証は firebase.json のエミュレータ
# (既定 9099)に向き、本番のIdentity Platformには一切繋がらない。
# ローカル開発では原則こちらを使う(`firebase emulators:start` で起動しておくこと)。
#
# 本番プロジェクトに対して手動で確認したいときだけ、この行をコメントアウトする。
# その場合はサインアップのたびに実アカウントが作られ、入力したアドレスへ
# 実際に確認メールが送信される点に注意する。
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Functionsエミュレータの接続先(既定 5001)。2FAリカバリーコードの発行・検証は
# Cloud Functions(callable)経由のため、ローカルで試すには `firebase emulators:start` で
# functions も起動しておく必要がある。
# 本番プロジェクトのFunctionsに向けたいときだけ、この行をコメントアウトする。
NEXT_PUBLIC_FIREBASE_FUNCTIONS_EMULATOR_URL=http://127.0.0.1:5001

# Firestoreエミュレータの接続先(既定 8080)。B2のCSV取込はクライアントSDKから
# Firestoreへ直接書き込むため、ローカルで試すには firestore も起動しておく必要がある。
# エミュレータのデータは再起動で消える点に注意する。
# 本番プロジェクトのFirestoreに向けたいときだけ、この行をコメントアウトする。
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_URL=http://127.0.0.1:8080

# 【開発時のみ】ログイン後の画面(B1〜B10)の認証ガードを迂回するか。
# Authエミュレータは多要素認証をSMSでしか実装しておらず、TOTPの登録要求を拒否するため、
# ローカルでは「2FA登録済み」の状態を作れず、ログイン後の画面を開こうとしても必ず
# A3 2FA登録画面へ戻される。画面の見た目・遷移をローカルで確認したいときだけ true にする。
#
# true にすると、ログイン画面に「開発用: ログインせずダッシュボードへ」の導線が出て、
# ログイン後の画面には迂回中であることを示す赤い帯が常時表示される。
# 実際にはサインインしていないため、認証そのものの確認には使えない。
#
# 本番ビルド(NODE_ENV=production)では、この値に関係なく迂回は無効になる。
NEXT_PUBLIC_BYPASS_APP_ACCESS_GUARD=false
