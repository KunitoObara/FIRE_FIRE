# Firebase クライアントSDKの設定値。
# このファイルをコピーして `.env.local` を作り、Firebaseコンソール
# (プロジェクトの設定 → マイアプリ → ウェブアプリ)の値を記入する。
# `.env.local` はコミットしない(.gitignore で除外済み)。
#
# ローカル開発では Firebase Emulator は使わず、常に fire-fire-dev(STG)プロジェクトの値を
# 設定する(B0-1)。fire-fire-dev はテスト用・開発用データが入っても本番に影響しない。
#
# NEXT_PUBLIC_FIREBASE_PROJECT_ID に本番(fire-fire-prod)を設定すると、開発時は
# Firebaseの初期化時点でエラーになる(本番へ実データを書き込まないための安全弁)。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 【開発時のみ】ログイン後の画面(B1〜B11)の認証ガードを迂回するか。
# サインアップ → メール確認 → TOTP登録という一連の流れを毎回通さずに、
# ログイン後の画面の見た目や遷移だけを素早く確認したいときに true にする。
#
# true にすると、ログイン画面に「開発用: ログインせずダッシュボードへ」の導線が出て、
# ログイン後の画面には迂回中であることを示す赤い帯が常時表示される。
# 実際にはサインインしていないため、認証そのものの確認には使えない
# (認証・2FA・セッションまわりを確認するときは false のまま実際にログインする)。
#
# 本番ビルド(NODE_ENV=production)では、この値に関係なく迂回は無効になる。
NEXT_PUBLIC_BYPASS_APP_ACCESS_GUARD=false

# E2Eテスト([X18])が使うテスト専用アカウントの資格情報。
# `npm run test:e2e` を実行するときだけ要る(通常の開発・`npm run dev`では読まれない)。
#
# - E2E_TEST_EMAIL / E2E_TEST_PASSWORD: fire-fire-devのsignupAllowlistへ事前登録した
#   テスト専用アカウント(開発者本人のアカウントとは別に用意する。docs/ci-cd-setup.md §14)
# - E2E_TEST_TOTP_SECRET: そのアカウントでA3のTOTP登録を済ませたときに発行されたシークレット
#   キー(Base32)。A3画面の「QRコードが読み取れない場合は、以下のキーを手動入力してください」
#   に表示される値(スペースは入れても除いても可。e2e/helpers/totp.tsで正規化する)
#
# いずれも実在するテストアカウントの秘密情報のため、このファイル(.env.example)には
# 絶対に値を書かない。
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
E2E_TEST_TOTP_SECRET=

# [X19] 3本目(e2e/auth-login.spec.ts)がA4の分岐先を実結線で確認するために使う、
# 状態を固定した2つの追加フィクスチャアカウント。任意設定 — 未設定の間は該当テストが
# `test.skip`で見送られる(グレースフルにスキップするだけで、テストスイート全体は壊れない)。
#
# - E2E_TEST_UNVERIFIED_EMAIL / E2E_TEST_UNVERIFIED_PASSWORD: A1でサインアップ済みだが
#   A2のメール確認リンクを一度もクリックしていないアカウント。「メール未確認→A2へ誘導」の
#   確認に使う。状態が変化しない(確認しない限りメール未確認のまま)ため、一度用意すれば
#   何度でも再利用できる
# - E2E_TEST_NO_TOTP_EMAIL / E2E_TEST_NO_TOTP_PASSWORD: A1〜A2(メール確認)まで完了して
#   いるが、A3のTOTP登録を行っていないアカウント。「2FA未登録→A3へ誘導」の確認に使う
#
# どちらもE2E_TEST_EMAILと同じくfire-fire-devのsignupAllowlistへの事前登録が要る
# (docs/ci-cd-setup.md §14)。後者はA2のメール確認(手動でリンクをクリック)まで済ませ、
# その先(A3のTOTP登録)には進まないでおく。
E2E_TEST_UNVERIFIED_EMAIL=
E2E_TEST_UNVERIFIED_PASSWORD=
E2E_TEST_NO_TOTP_EMAIL=
E2E_TEST_NO_TOTP_PASSWORD=

# [X3] SentryのDSN(フロントエンド用プロジェクト)。
# Sentryコンソールの Settings → Client Keys (DSN) で確認できる。
#
# 未設定のままなら Sentry は起動せず、イベントを一切送らない。ローカル開発では
# 通常は空のままにしておく(手元のエラーがSTGの通知に混ざらないようにするため)。
# ローカルから実際に送信を試したいときだけ、fire-fire-dev 用のDSNを入れる。
#
# `environment` タグは NEXT_PUBLIC_FIREBASE_PROJECT_ID をそのまま使うので、
# 専用の環境変数は要らない。
NEXT_PUBLIC_SENTRY_DSN=

# [X3] ソースマップのアップロード用。ビルド時にだけ使う(実行時のバンドルには入らない)。
# 未設定ならアップロードをまるごとスキップしてビルドは成功する — つまり通常の
# ローカル開発では要らない。設定するのはCI・App Hostingのビルドだけ。
# SENTRY_AUTH_TOKEN は Sentry の Organization Settings → Auth Tokens で
# `project:releases` スコープを付けて発行する。
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
