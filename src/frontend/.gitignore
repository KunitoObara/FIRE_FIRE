# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# プレースホルダーのみのテンプレートはコミットする
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright ([X18] E2Eテスト基盤。実行結果であり、fixtureのCSV(e2e/fixtures/)とは別物)
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# [X19] ログイン済みのFirebaseセッションを保存するstorageState(実際のセッショントークンを
# 含むため、実行結果の一種として絶対にコミットしない。fixtureのCSVとは別物)
/e2e/.auth/
