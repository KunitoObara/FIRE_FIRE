{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": [
    {
      "target": "default-bucket",
      "rules": "storage.rules"
    }
  ],
  "functions": [
    {
      "source": "src/backend",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "docs",
        "**/*.test.ts",
        "**/*.spec.ts",
        "lib/**/*.test.js",
        "lib/**/*.test.js.map",
        "lib/**/*.spec.js",
        "lib/**/*.spec.js.map"
      ]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "functions": {
      "port": 5001
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
